global x; global lcm; global l; global denom; global i; global c;
proc main() {
  lcm = 1; i = 253;
  while (true) {
    x = x + 1;
    l = lcm;
    while (lcm != (lcm / x) * x) { lcm = lcm + l; }
    if (i > 0) { i = i - 1; } else {
      l = 0; denom = 1; i = 1;
      while (i <= lcm) {
        l = l * i + denom;
        c = c * i;
        denom = denom * i;
        if (i <= x) { c = l; }
        i = i + 1;
      }
      l = l - denom * x;
      l = l * denom;
      c = c * c;
      i = 0;
      c = c * c;
      l = l * l;
      c = c * x;
      builtin_halt_if_gt_destroy(l, c);
    }
  }
}
