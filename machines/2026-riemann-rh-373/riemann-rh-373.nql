global x; global lcm; global l; global denom; global i; global c; global j; global k;
proc main() {
  lcm = 1;
  while (true) {
    x = x + 1;
    c = lcm;
    while (lcm != (lcm / x) * x) { lcm = lcm + c; }
    i = 1; denom = 1;
    j = j + lcm;
    k = k + x;
    while (j > 0) {
      j = j - 1;
      c = c * i;
      l = l * i + denom;
      if (k > 0) { k = k - 1; c = l; }
      denom = denom * i;
      i = i + 1;
    }
    l = l - denom * x;
    c = c * c;
    l = l * denom;
    c = c * c;
    c = c * x;
    l = l * l;
    builtin_halt_if_gt_destroy(l, c);
  }
}
