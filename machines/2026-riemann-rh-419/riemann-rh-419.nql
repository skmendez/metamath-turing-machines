global x; global lcm; global l; global denom; global i; global c;
proc main() {
  lcm = 1;
  while (true) {
    x = x + 1;
    l = lcm;
    while (lcm != (lcm / x) * x) { lcm = lcm + l; }
    i = 1; denom = 1; l = 0;
    while (i <= lcm) {
      c = c * i;
      l = l * i + denom;
      if (i <= x) { c = l; }
      denom = denom * i;
      i = i + 1;
    }
    l = l - denom * x;
    c = c * c;
    l = l * denom;
    c = c * c;
    c = c * x;
    l = l * l;
    builtin_halt_if_gt_destroy(l, c);
  }
}
